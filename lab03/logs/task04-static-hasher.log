+ hsh-install /home/user/rdsu-lab03/rpm/hasher gcc make glibc-devel-static
+ hsh-run -- /home/user/rdsu-lab03/rpm/hasher /bin/bash -ec '
    rpm -q glibc-devel-static
    work=$(mktemp -d)
    cd "$work"
    tar xzf -
    cd rdsu-args-1.0
    make rdsu-args-static
    cc -static -o fully-static main.o -L. -lrdsuargs
    stat -c "%n %s bytes" rdsu-args-static fully-static
    for exe in rdsu-args-static fully-static; do
        printf "%s symbol count: " "$exe"
        nm "$exe" | wc -l
        status=0
        ldd "./$exe" || status=$?
        echo "ldd exit=$status"
    done
    ./rdsu-args-static alpha beta gamma > normal.out
    ./fully-static alpha beta gamma > full.out
    cmp normal.out full.out
    echo "static comparison exit=$?"
  '
